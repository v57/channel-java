#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
./gradlew --no-daemon clean :channel-java-quic:test :channel-java-tests:test --tests v57.channel.tests.AllTestsSuite :channel-java-tests:jacocoTestReport

XML_REPORT="$ROOT/channel-java-tests/build/reports/jacoco/test/jacocoTestReport.xml"
LCOV_OUT="$ROOT/coverage/lcov.info"

mkdir -p "$ROOT/coverage"
python3 "$ROOT/scripts/jacoco_to_lcov.py" \
  --xml "$XML_REPORT" \
  --out "$LCOV_OUT" \
  --root "$ROOT" \
  --module "$ROOT/channel-java-core" \
  --module "$ROOT/channel-java-client" \
  --module "$ROOT/channel-java-server" \
  --module "$ROOT/channel-java-process" \
  --module "$ROOT/channel-java-quic"

if [[ ! -s "$LCOV_OUT" ]]; then
  echo "coverage conversion failed: $LCOV_OUT is missing or empty" >&2
  exit 1
fi

echo "LCOV generated at $LCOV_OUT"
